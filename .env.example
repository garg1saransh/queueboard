# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/async_job_queue?schema=public

# Redis (BullMQ + realtime pub/sub) — Redis 5+ required
REDIS_URL=redis://localhost:6379

# Worker simulation (optional)
# JOB_SUCCESS_RATE=0.7
# JOB_MIN_DELAY_MS=1000
# JOB_MAX_DELAY_MS=5000
